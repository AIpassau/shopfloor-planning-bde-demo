<Window x:Class="ShopfloorPlanningBdeDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shopfloor Planning &amp; BDE Demo"
        Height="820"
        Width="1280"
        MinHeight="760"
        MinWidth="1150"
        Background="#1F2427"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="0,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Background" Value="#FFC400" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#2F3437"
                Padding="20,26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="SHOP"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold" />
                    <TextBlock Text="FLOOR"
                               Foreground="#FFC400"
                               FontSize="26"
                               FontWeight="Bold" />
                    <Border Height="3"
                            Width="82"
                            Background="#FFC400"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,54,0,0">
                    <Button x:Name="HomeNavButton"
                            Content="HOME"
                            Style="{StaticResource NavButtonStyle}"
                            Foreground="#FFC400"
                            Click="HomeNavButton_Click" />

                    <Border Height="1"
                            Background="#FFC400"
                            Margin="0,0,84,18" />

                    <Button x:Name="BdeNavButton"
                            Content="BDE TERMINAL"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BdeNavButton_Click" />

                    <Button x:Name="DatabaseNavButton"
                            Content="SQLITE DATABASE"
                            Style="{StaticResource NavButtonStyle}"
                            Click="DatabaseNavButton_Click" />

                    <Button x:Name="AiNavButton"
                            Content="LLM REPORT ANALYSIS"
                            Style="{StaticResource NavButtonStyle}"
                            Click="AiNavButton_Click" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border BorderBrush="#FFC400"
                            BorderThickness="1"
                            CornerRadius="34"
                            Width="68"
                            Height="68"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,18">
                        <TextBlock Text="DB"
                                   Foreground="#FFC400"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Portfolio Demo"
                               Foreground="#CBD5E1"
                               FontSize="12" />
                    <TextBlock Text="WPF · C# · SQLite · LLM"
                               Foreground="#94A3B8"
                               FontSize="11"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="118" />
                <RowDefinition Height="*" />
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#1F2427"
                    Padding="28,22">
                <DockPanel LastChildFill="True">
                    <Button x:Name="LanguageButton"
                            DockPanel.Dock="Right"
                            Content="EN"
                            Width="58"
                            Height="34"
                            Background="#FFC400"
                            Click="ToggleLanguage_Click" />

                    <StackPanel>
                        <TextBlock x:Name="MainTitleTextBlock"
                                   Text="Shopfloor Planning &amp; BDE Terminal"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock x:Name="MainSubtitleTextBlock"
                                   Text="Demo für Fertigungsaufträge, Maschinenstatus und Betriebsdatenerfassung"
                                   FontSize="14"
                                   Foreground="#CBD5E1"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="24,0,24,0">

                <!-- HOME PAGE -->
                <Grid x:Name="HomeView">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="6"
                            Padding="16"
                            Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock x:Name="OrdersTitleTextBlock"
                                       Text="Fertigungsaufträge"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#111827" />
                            <TextBlock x:Name="OrdersSubtitleTextBlock"
                                       Text="Aktive Auftragsliste"
                                       FontSize="12"
                                       Foreground="#6B7280"
                                       Margin="0,4,0,16" />

                            <Border Background="#FFF7D6"
                                    BorderBrush="#FFC400"
                                    BorderThickness="0,0,0,3"
                                    Padding="12"
                                    CornerRadius="4"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="FA-240091" FontSize="16" FontWeight="Bold" Foreground="#111827" />
                                    <TextBlock Text="Artikel: Distanzstück D-120" Foreground="#4B5563" Margin="0,5,0,0" />
                                    <TextBlock Text="AFO: 1. Spannung fräsen" Foreground="#4B5563" FontSize="12" Margin="0,4,0,0" />
                                    <TextBlock Text="Menge: 82 / 120 | Status: Läuft" Foreground="#2EA043" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    Padding="12"
                                    CornerRadius="4"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="FA-240092" FontSize="16" FontWeight="Bold" Foreground="#111827" />
                                    <TextBlock Text="Artikel: Sensorhalter S-18" Foreground="#4B5563" Margin="0,5,0,0" />
                                    <TextBlock Text="AFO: Werkzeugwechsel" Foreground="#4B5563" FontSize="12" Margin="0,4,0,0" />
                                    <TextBlock Text="Menge: 0 / 20 | Status: Rüsten" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    Padding="12"
                                    CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="FA-240093" FontSize="16" FontWeight="Bold" Foreground="#111827" />
                                    <TextBlock Text="Artikel: Montageplatte M-7" Foreground="#4B5563" Margin="0,5,0,0" />
                                    <TextBlock Text="AFO: Verpacken" Foreground="#4B5563" FontSize="12" Margin="0,4,0,0" />
                                    <TextBlock Text="Menge: 0 / 45 | Status: Wartet" Foreground="#6B7280" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="White"
                            CornerRadius="6"
                            Padding="18">
                        <StackPanel>
                            <TextBlock x:Name="PlanningTitleTextBlock"
                                       Text="Planning Board"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#111827" />
                            <TextBlock x:Name="PlanningSubtitleTextBlock"
                                       Text="Maschinen- und Arbeitsplatzübersicht"
                                       FontSize="12"
                                       Foreground="#6B7280"
                                       Margin="0,4,0,16" />

                            <UniformGrid Columns="2" Rows="2">
                                <Border Background="#F8FAFC" BorderBrush="#D9DEE3" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,12,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="CNC-01" FontSize="20" FontWeight="Bold" Foreground="#111827" />
                                            <Border DockPanel.Dock="Right" Background="#DCFCE7" CornerRadius="10" Padding="8,3">
                                                <TextBlock Text="Läuft" Foreground="#166534" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="FA-240091" Foreground="#4B5563" Margin="0,12,0,0" />
                                        <TextBlock Text="82 / 120" FontSize="22" FontWeight="Bold" Foreground="#111827" Margin="0,8,0,0" />
                                        <Grid Height="10" Margin="0,12,0,0">
                                            <Border Background="#E5E7EB" CornerRadius="5" />
                                            <Border Background="#2EA043" Width="150" HorizontalAlignment="Left" CornerRadius="5" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC" BorderBrush="#D9DEE3" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="CNC-02" FontSize="20" FontWeight="Bold" Foreground="#111827" />
                                            <Border DockPanel.Dock="Right" Background="#FEF3C7" CornerRadius="10" Padding="8,3">
                                                <TextBlock Text="Rüsten" Foreground="#92400E" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="FA-240092" Foreground="#4B5563" Margin="0,12,0,0" />
                                        <TextBlock Text="Tool setup" FontSize="22" FontWeight="Bold" Foreground="#111827" Margin="0,8,0,0" />
                                        <Grid Height="10" Margin="0,12,0,0">
                                            <Border Background="#E5E7EB" CornerRadius="5" />
                                            <Border Background="#FFC400" Width="120" HorizontalAlignment="Left" CornerRadius="5" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC" BorderBrush="#D9DEE3" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,12,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="PRESS-01" FontSize="20" FontWeight="Bold" Foreground="#111827" />
                                            <Border DockPanel.Dock="Right" Background="#FEE2E2" CornerRadius="10" Padding="8,3">
                                                <TextBlock Text="Stop" Foreground="#991B1B" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="Grund" Foreground="#4B5563" Margin="0,12,0,0" />
                                        <TextBlock Text="Material fehlt" FontSize="22" FontWeight="Bold" Foreground="#111827" Margin="0,8,0,0" />
                                        <Grid Height="10" Margin="0,12,0,0">
                                            <Border Background="#E5E7EB" CornerRadius="5" />
                                            <Border Background="#E5533D" Width="80" HorizontalAlignment="Left" CornerRadius="5" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC" BorderBrush="#D9DEE3" BorderThickness="1" CornerRadius="5" Padding="14">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="PACK-01" FontSize="20" FontWeight="Bold" Foreground="#111827" />
                                            <Border DockPanel.Dock="Right" Background="#E5E7EB" CornerRadius="10" Padding="8,3">
                                                <TextBlock Text="Wartet" Foreground="#374151" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="Nächster Auftrag" Foreground="#4B5563" Margin="0,12,0,0" />
                                        <TextBlock Text="FA-240093" FontSize="22" FontWeight="Bold" Foreground="#111827" Margin="0,8,0,0" />
                                        <Grid Height="10" Margin="0,12,0,0">
                                            <Border Background="#E5E7EB" CornerRadius="5" />
                                            <Border Background="#9CA3AF" Width="55" HorizontalAlignment="Left" CornerRadius="5" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- BDE PAGE -->
                <Border x:Name="BdeView"
                        Visibility="Collapsed"
                        Background="White"
                        CornerRadius="6"
                        Padding="22">
                    <StackPanel Width="520" HorizontalAlignment="Left">
                        <TextBlock x:Name="BdeTitleTextBlock" Text="BDE Rückmeldung" FontSize="22" FontWeight="Bold" Foreground="#111827" />
                        <TextBlock x:Name="BdeSubtitleTextBlock" Text="Betriebsdatenerfassung" FontSize="13" Foreground="#6B7280" Margin="0,4,0,20" />

                        <TextBlock x:Name="EmployeeLabelTextBlock" Text="Mitarbeiter" Style="{StaticResource LabelStyle}" />
                        <TextBox Text="J. Huang" Margin="0,0,0,10" />

                        <TextBlock x:Name="OrderLabelTextBlock" Text="Auftrag" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="OrderNumberTextBox" Text="FA-240091" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="GoodLabelTextBlock" Text="Gutmenge" Style="{StaticResource LabelStyle}" />
                                <TextBox x:Name="GoodQuantityTextBox" Text="82" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="ScrapLabelTextBlock" Text="Ausschuss" Style="{StaticResource LabelStyle}" />
                                <TextBox x:Name="ScrapQuantityTextBox" Text="3" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="CommentLabelTextBlock" Text="Kommentar" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="CommentTextBox"
                                 Text="Small surface defects detected."
                                 Height="80"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="0,0,0,16" />

                        <Button x:Name="SaveFeedbackButton"
                                Content="Rückmeldung speichern"
                                Background="#FFC400"
                                Click="SaveFeedback_Click" />

                        <Border Background="#F8FAFC"
                                BorderBrush="#D9DEE3"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12"
                                Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock x:Name="LastFeedbackTitleTextBlock" Text="Letzte Rückmeldung" FontWeight="Bold" Foreground="#111827" />
                                <TextBlock x:Name="LastFeedbackTextBlock" Text="Noch keine Rückmeldung gespeichert." TextWrapping="Wrap" Foreground="#374151" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- DATABASE PAGE -->
                <Border x:Name="DatabaseView"
                        Visibility="Collapsed"
                        Background="White"
                        CornerRadius="6"
                        Padding="22">
                    <StackPanel>
                        <TextBlock Text="SQLite Database"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#111827" />
                        <TextBlock Text="Persisted BDE feedback records from the local shopfloor terminal database."
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,4,0,18" />

                        <ListBox x:Name="FeedbackHistoryListBox"
                                 Height="420"
                                 BorderBrush="#D1D5DB"
                                 BorderThickness="1" />
                    </StackPanel>
                </Border>

                <!-- AI REPORT PAGE -->
                <Border x:Name="AiView"
                        Visibility="Collapsed"
                        Background="#111827"
                        CornerRadius="6"
                        Padding="22">
                    <StackPanel Width="720" HorizontalAlignment="Left">
                        <TextBlock x:Name="AiReportTitleTextBlock"
                                   Text="KI-Berichtsanalyse"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White" />

                        <TextBlock x:Name="AiReportSubtitleTextBlock"
                                   Text="LLM-Analyse der letzten BDE-Rückmeldungen"
                                   FontSize="13"
                                   Foreground="#CBD5E1"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,18" />

                        <Button x:Name="GenerateAiReportButton"
                                Content="KI-Bericht erstellen"
                                Background="#FFC400"
                                Width="220"
                                HorizontalAlignment="Left"
                                Click="GenerateAiReport_Click"
                                Margin="0,0,0,16" />

                        <Border Background="#F9FAFB"
                                BorderBrush="#374151"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="14"
                                MinHeight="360">
                            <TextBlock x:Name="AiReportTextBlock"
                                       Text="Noch kein KI-Bericht erstellt."
                                       FontSize="13"
                                       Foreground="#111827"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="#1F2427"
                    Padding="24,0">
                <TextBlock x:Name="FooterTextBlock"
                           Text="Portfolio-Demo: WPF, C#, Produktionsplanung, BDE, SQLite, LLM-Berichtsanalyse"
                           VerticalAlignment="Center"
                           Foreground="#94A3B8"
                           FontSize="12" />
            </Border>
        </Grid>
    </Grid>
</Window>